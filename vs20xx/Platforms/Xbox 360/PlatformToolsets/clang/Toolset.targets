<!--
***********************************************************************************************
RXDK-360 "clang" platform toolset - build targets.

Imported at the END of Platform.targets (after the stock ClCompile/Link/ImageXex
targets are defined), so these definitions OVERRIDE them: an RXDK-360 project set
to <PlatformToolset>clang</PlatformToolset> builds with the clang/LLVM
toolchain instead of the stock XDK cl.exe/link.exe/imagexex.

  ClCompile - patched MS-PPC clang, one object per source into $(IntDir).
  Link      - discover kernel imports (ld.lld trial link) -> XexTool genstubs ->
              assemble stubs -> final link -> XexTool pack, straight to the .xex.
              (ImageXex is therefore a no-op for this toolset - packing already
              happened in Link, including Image Conversion title id / privileges
              via XexTool applyxml.)
  Lib       - not yet supported for the clang toolchain (no archiver shipped);
              use a stock-toolset (2010-01) StaticLibrary, or link sources directly.

WARNING:  DO NOT MODIFY unless you understand MSBuild.
***********************************************************************************************
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(VCTargetsPath)\Platforms\Xbox 360\ImportBefore\*.clang.targets" Condition="Exists('$(VCTargetsPath)\Platforms\Xbox 360\ImportBefore')" />

  <UsingTask TaskName="Rxdk.Xbox360.Clang.Build.ClangCompile" AssemblyFile="$(MSBuildThisFileDirectory)..\..\Rxdk.Xbox360.Clang.Build.dll"/>
  <UsingTask TaskName="Rxdk.Xbox360.Clang.Build.ClangLink"    AssemblyFile="$(MSBuildThisFileDirectory)..\..\Rxdk.Xbox360.Clang.Build.dll"/>

  <PropertyGroup>
    <!-- Where the clang link stage writes its scratch (.ld/.elf/stubs), kept out
         of $(IntDir) so the object glob below sees only compiled sources. -->
    <RxdkClangLinkDir Condition="'$(RxdkClangLinkDir)' == ''">$(IntDir)link\</RxdkClangLinkDir>
    <!-- Comma/semicolon list of extra libraries (bare name -> coff archive). The
         clang runtime (libc.a/libcpp.a/xapilib.a) is auto-linked unless opted out. -->
    <RxdkClangLibs Condition="'$(RxdkClangLibs)' == ''"></RxdkClangLibs>
    <RxdkClangNoDefaultLibs Condition="'$(RxdkClangNoDefaultLibs)' == ''">false</RxdkClangNoDefaultLibs>

    <!-- Debug configs compile with DWARF at -O0 and keep the linked .elf beside
         the .xex as the symbol file (source-level debugging reads DWARF from it,
         mapped onto the XEX load base); Release optimises with no debug info. -->
    <RxdkClangDebug Condition="'$(RxdkClangDebug)' == '' and '$(Configuration)' == 'Debug'">true</RxdkClangDebug>
    <RxdkClangDebug Condition="'$(RxdkClangDebug)' == ''">false</RxdkClangDebug>
    <RxdkClangOpt Condition="'$(RxdkClangOpt)' == '' and '$(RxdkClangDebug)' == 'true'">-O0</RxdkClangOpt>
    <RxdkClangOpt Condition="'$(RxdkClangOpt)' == ''">-O2</RxdkClangOpt>

    <!-- XDK-headers mode: compile against the stock XDK headers (D3D9 / XGraphics /
         xtl.h) with the MS-compat recipe, for titles that use the XDK API surface
         (e.g. a D3D9 game). Off by default (pure modern C/C++23 on picolibc/libc++).
         The XDK headers are C++03-era, so this mode compiles at c++14. -->
    <RxdkClangXdkHeaders Condition="'$(RxdkClangXdkHeaders)' == ''">false</RxdkClangXdkHeaders>
    <RxdkClangCppStd Condition="'$(RxdkClangCppStd)' == '' and '$(RxdkClangXdkHeaders)' == 'true'">c++14</RxdkClangCppStd>
    <RxdkClangCppStd Condition="'$(RxdkClangCppStd)' == ''">c++23</RxdkClangCppStd>
  </PropertyGroup>

  <!-- ***** ClCompile ***** -->
  <Target Name="ClCompile"
          Condition="'@(ClCompile)' != ''"
          DependsOnTargets="SelectClCompile">
    <!-- Project-level include dirs / defines / options, taken as the union across
         the ClCompile items (VS sets these identically per configuration). -->
    <PropertyGroup>
      <_RxdkInc>@(ClCompile->'%(AdditionalIncludeDirectories)'->Distinct())</_RxdkInc>
      <_RxdkDef>@(ClCompile->'%(PreprocessorDefinitions)'->Distinct())</_RxdkDef>
      <_RxdkOpt>@(ClCompile->'%(AdditionalOptions)'->Distinct())</_RxdkOpt>
    </PropertyGroup>

    <ClangCompile
        ClangPath="$(RxdkClangPath)"
        RxdkRoot="$(RxdkClangRoot)"
        PicolibcIncludeDir="$(RxdkPicolibcInc)"
        ConfigDir="$(RxdkConfigInc)"
        LibcxxIncludeDir="$(RxdkLibcxxInc)"
        LibcxxabiIncludeDir="$(RxdkLibcxxabiInc)"
        OutputDir="$(IntDir)"
        Sources="@(ClCompile)"
        Optimization="$(RxdkClangOpt)"
        LanguageStandardCpp="$(RxdkClangCppStd)"
        DebugInformation="$(RxdkClangDebug)"
        Lto="$(RxdkClangLto)"
        XdkHeaders="$(RxdkClangXdkHeaders)"
        XdkIncludeDirectories="$(RxdkXdkIncludeDir)"
        AdditionalIncludeDirectories="$(_RxdkInc)"
        PreprocessorDefinitions="$(_RxdkDef)"
        AdditionalOptions="$(_RxdkOpt)" />
  </Target>

  <!-- ***** Clean *****
       ClangCompile writes its .o objects straight into $(IntDir) with no MSBuild
       tracking log, so the stock Clean (which removes only tlog-tracked outputs)
       leaves them behind. Since Rebuild is Clean+Build and ClangCompile skips any
       source whose .o is newer, a Rebuild would otherwise silently relink stale
       objects and source edits (especially in a StaticLibrary like Common) never
       take effect. Delete the objects on Clean so Rebuild truly recompiles. -->
  <Target Name="RxdkClangClean" AfterTargets="Clean">
    <ItemGroup>
      <_RxdkCleanObj Include="$(IntDir)*.o" />
      <_RxdkCleanObj Include="$(RxdkClangLinkDir)*.o" Condition="'$(RxdkClangLinkDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(_RxdkCleanObj)" TreatErrorsAsWarnings="true" />
  </Target>

  <!-- ***** Link (compile discovery + pack straight to .xex) ***** -->
  <Target Name="Link"
          Condition="'@(Link)' != '' and ('$(ConfigurationType)' == 'Application' or '$(ConfigurationType)' == 'DynamicLibrary')"
          DependsOnTargets="ComputeLinkSwitches">
    <PropertyGroup>
      <_ClangXex>@(ImageXex->'%(ImageXexOutput)')</_ClangXex>
      <_ClangXex Condition="'$(_ClangXex)' == ''">$(OutDir)$(TargetName).xex</_ClangXex>
      <_ClangBase>@(ImageXex->'%(BaseAddress)')</_ClangBase>
      <_ClangBase Condition="'$(_ClangBase)' == ''">0x82000000</_ClangBase>
      <!-- The standard Linker -> Input -> Additional Dependencies field, mirroring an
           official title. The task maps each .lib to the clang equivalent (code
           archive / CRT / XEX-import-via-genstubs). Same across the Link items. -->
      <_ClangLinkDeps>@(Link->'%(AdditionalDependencies)'->Distinct())</_ClangLinkDeps>
    </PropertyGroup>
    <ItemGroup>
      <_ClangObj Include="$(IntDir)*.o" />
    </ItemGroup>

    <ClangLink
        ClangPath="$(RxdkClangPath)"
        LldPath="$(RxdkLldPath)"
        XexToolPath="$(RxdkXexToolPath)"
        Objects="@(_ClangObj)"
        OutputFile="$(_ClangXex)"
        IntDir="$(RxdkClangLinkDir)"
        XdkLibDir="$(RxdkXdkLibDir)"
        CoffDir="$(RxdkCoffDir)"
        LibcDir="$(RxdkLibcDir)"
        BaseAddress="$(_ClangBase)"
        TitleID="%(ImageXex.TitleID)"
        LanKey="%(ImageXex.LanKey)"
        HeapSize="%(ImageXex.HeapSize)"
        WorkspaceSize="%(ImageXex.WorkspaceSize)"
        ExportByName="%(ImageXex.ExportByName)"
        OpticalDiscDriveMapping="%(ImageXex.OpticalDiscDriveMapping)"
        Pal50Incompatible="%(ImageXex.Pal50Incompatible)"
        MultiDiscTitle="%(ImageXex.MultiDiscTitle)"
        PreferBigButtonInput="%(ImageXex.PreferBigButtonInput)"
        CrossPlatformSystemLink="%(ImageXex.CrossPlatformSystemLink)"
        AllowAvatarGetMetadata="%(ImageXex.AllowAvatarGetMetadata)"
        AllowControllerSwapping="%(ImageXex.AllowControllerSwapping)"
        RequireFullExperience="%(ImageXex.RequireFullExperience)"
        GameVoiceRequiredUI="%(ImageXex.GameVoiceRequiredUI)"
        KinectElevationControl="%(ImageXex.KinectElevationControl)"
        KinectSupportLevel="%(ImageXex.KinectSupportLevel)"
        ConfigurationFile="%(ImageXex.ConfigurationFile)"
        AdditionalSections="%(ImageXex.AdditionalSections)"
        Libraries="$(RxdkClangLibs)"
        AdditionalDependencies="$(_ClangLinkDeps)"
        NoDefaultLibs="$(RxdkClangNoDefaultLibs)"
        KeepElf="$(RxdkClangDebug)"
        AdditionalOptions="%(Link.AdditionalOptions)" />

    <Message Text="$(MSBuildProjectFile) -&gt; $(_ClangXex)" Importance="High" />
  </Target>

  <!-- ***** ImageXex ***** : packing already happened in Link. -->
  <Target Name="ImageXex"
          AfterTargets="Link"
          Condition="'@(ImageXex)' != '' and ('$(ConfigurationType)' == 'Application' or '$(ConfigurationType)' == 'DynamicLibrary')">
    <Message Text="ImageXex: skipped (the clang toolset packs the XEX during Link)." Importance="Low" />
  </Target>

  <!-- ***** Lib ***** : archive the compiled objects into a System V .a (named
       .lib) with llvm-ar. An archive is pulled member-by-member on demand, so a
       title links only the objects it actually uses; a single merged relocatable
       object (the old ld.lld -r) is pulled WHOLE and its per-TU static
       initializers (.init_array) root every object, dragging the whole library -
       and every XDK API it references - into a title that touches one class. -->
  <Target Name="Lib"
          Condition="'$(ConfigurationType)' == 'StaticLibrary'"
          DependsOnTargets="ClCompile">
    <ItemGroup>
      <_ClangLibObj Include="$(IntDir)*.o" />
    </ItemGroup>
    <Error Condition="'@(_ClangLibObj)' == ''" Text="RXDK-360 clang toolset: no compiled objects to archive." />
    <PropertyGroup>
      <_ClangLibOut Condition="'$(_ClangLibOut)' == ''">$(OutDir)$(TargetName).lib</_ClangLibOut>
      <_ClangLibOut Condition="'$(OutputFile)' != ''">$(OutputFile)</_ClangLibOut>
      <_ClangLibObjs>@(_ClangLibObj->'&quot;%(FullPath)&quot;', ' ')</_ClangLibObjs>
    </PropertyGroup>
    <MakeDir Directories="$(OutDir)" />
    <!-- Delete first: llvm-ar 'rc' updates in place, so a stale archive would
         keep members from sources that no longer exist. -->
    <Delete Files="$(_ClangLibOut)" />
    <Exec Command="&quot;$(RxdkArPath)&quot; rcs &quot;$(_ClangLibOut)&quot; $(_ClangLibObjs)" />
    <Message Importance="High" Text="$(MSBuildProjectFile) -&gt; $(_ClangLibOut)" />
  </Target>

  <Import Project="$(VCTargetsPath)\Platforms\Xbox 360\ImportAfter\*.clang.targets" Condition="Exists('$(VCTargetsPath)\Platforms\Xbox 360\ImportAfter')" />
</Project>
