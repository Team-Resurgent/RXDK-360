<!--
***********************************************************************************************
RXDK-360 "clang" platform toolset - properties.

The MODERN toolchain: titles are built with the patched MS-PPC clang + LLVM lld
and packed by XexTool, instead of the stock XDK cl.exe/link.exe/imagexex. Selected
per project with <PlatformToolset>clang</PlatformToolset> under <Platform>RXDK-360.

This file resolves the two roots the modern build needs:
  * XDKInstallDir  - the (relocated, side-by-side) XDK, for its import libraries
                     (lib\xbox), the same resolution the stock toolset uses; and
  * RxdkModernRoot - the modern toolchain payload (clang/lld/XexTool + the C/C++
                     runtime archives and headers). Every tool/dir below derives
                     from it and is individually overridable, so the dev tree and
                     an installed layout differ only in these property values.

WARNING:  DO NOT MODIFY unless you understand MSBuild; a bad edit here breaks
          loading/building RXDK-360 projects.
***********************************************************************************************
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(VCTargetsPath)\Platforms\Xbox 360\ImportBefore\*.clang.props" Condition="Exists('$(VCTargetsPath)\Platforms\Xbox 360\ImportBefore')" />
  <Import Project="$(VCTargetsPath)\Platforms\Xbox 360\Rxdk.InstallLayout.props" />

  <PropertyGroup>
    <!-- Relocated XDK at {app} (include, lib, bin). Same resolution as 2010-01. -->

    <!-- The modern toolchain payload root. Env RXDK360_MODERN wins (dev tree);
         then RXDK-360's own registry ModernPath; else {app}\modern. -->
    <RxdkModernRoot Condition="'$(RxdkModernRoot)' == '' and '$(RXDK360_MODERN)' != ''">$(RXDK360_MODERN)</RxdkModernRoot>
    <RxdkModernRoot Condition="'$(RxdkModernRoot)' == ''">$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\TeamResurgent\RXDK-360@ModernPath)</RxdkModernRoot>
    <RxdkModernRoot Condition="'$(RxdkModernRoot)' == ''">$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\TeamResurgent\RXDK-360@ModernPath)</RxdkModernRoot>
    <RxdkModernRoot Condition="'$(RxdkModernRoot)' == '' and '$(RxdkInstallDir)' != '' and Exists('$(RxdkInstallDir)modern\bin\clang.exe')">$(RxdkInstallDir)modern</RxdkModernRoot>
    <RxdkModernRoot Condition="'$(RxdkModernRoot)' == ''">$(XDKInstallDir)</RxdkModernRoot>
    <RxdkModernRoot Condition="'$(RxdkModernRoot)' != '' and HasTrailingSlash('$(RxdkModernRoot)')">$(RxdkModernRoot.TrimEnd('\'))</RxdkModernRoot>

    <!-- Two supported layouts, detected by whether the clean installed tree exists:
         INSTALLED (clean)  RxdkModernRoot\{bin,lib,include}
         DEV (source tree)  RxdkModernRoot\{build\llvm\bin, build\libc, build\coff,
                            vendor\..., runtime\config} + the XDK install for headers.
         Everything is overridable. -->
    <_RxdkClean Condition="'$(_RxdkClean)' == '' and Exists('$(RxdkModernRoot)\bin\clang.exe')">true</_RxdkClean>

    <!-- binary tools -->
    <RxdkClangPath   Condition="'$(RxdkClangPath)'   == '' and '$(_RxdkClean)' == 'true'">$(RxdkModernRoot)\bin\clang.exe</RxdkClangPath>
    <RxdkClangPath   Condition="'$(RxdkClangPath)'   == ''">$(RxdkModernRoot)\build\llvm\bin\clang.exe</RxdkClangPath>
    <RxdkLldPath     Condition="'$(RxdkLldPath)'     == '' and '$(_RxdkClean)' == 'true'">$(RxdkModernRoot)\bin\ld.lld.exe</RxdkLldPath>
    <RxdkLldPath     Condition="'$(RxdkLldPath)'     == ''">$(RxdkModernRoot)\build\llvm\bin\ld.lld.exe</RxdkLldPath>
    <RxdkXexToolPath Condition="'$(RxdkXexToolPath)' == '' and '$(_RxdkClean)' == 'true'">$(RxdkModernRoot)\bin\XexTool.exe</RxdkXexToolPath>
    <RxdkXexToolPath Condition="'$(RxdkXexToolPath)' == ''">$(RxdkModernRoot)\vendor\xextool\build\Release\XexTool.exe</RxdkXexToolPath>

    <!-- library dirs: clean layout keeps every archive (our libc/libcpp, the coff2elf
         libs, and the copied XDK import .libs for genstubs) under a single lib\. -->
    <RxdkLibcDir Condition="'$(RxdkLibcDir)' == '' and '$(_RxdkClean)' == 'true'">$(RxdkModernRoot)\lib</RxdkLibcDir>
    <RxdkLibcDir Condition="'$(RxdkLibcDir)' == ''">$(RxdkModernRoot)\build\libc</RxdkLibcDir>
    <RxdkCoffDir Condition="'$(RxdkCoffDir)' == '' and '$(_RxdkClean)' == 'true'">$(RxdkModernRoot)\lib</RxdkCoffDir>
    <RxdkCoffDir Condition="'$(RxdkCoffDir)' == ''">$(RxdkModernRoot)\build\coff</RxdkCoffDir>

    <!-- modern C/C++23 runtime include dirs (picolibc + libc++), passed to the
         compile task explicitly so the clean and dev layouts both work. -->
    <RxdkPicolibcInc  Condition="'$(RxdkPicolibcInc)'  == '' and '$(_RxdkClean)' == 'true'">$(RxdkModernRoot)\include\picolibc</RxdkPicolibcInc>
    <RxdkPicolibcInc  Condition="'$(RxdkPicolibcInc)'  == ''">$(RxdkModernRoot)\vendor\picolibc\libc\include</RxdkPicolibcInc>
    <RxdkConfigInc    Condition="'$(RxdkConfigInc)'    == '' and '$(_RxdkClean)' == 'true'">$(RxdkModernRoot)\include\config</RxdkConfigInc>
    <RxdkConfigInc    Condition="'$(RxdkConfigInc)'    == ''">$(RxdkModernRoot)\runtime\config</RxdkConfigInc>
    <RxdkLibcxxInc    Condition="'$(RxdkLibcxxInc)'    == '' and '$(_RxdkClean)' == 'true'">$(RxdkModernRoot)\include\libcxx</RxdkLibcxxInc>
    <RxdkLibcxxInc    Condition="'$(RxdkLibcxxInc)'    == '' and Exists('$(RxdkModernRoot)\build\llvm\libcxx\include')">$(RxdkModernRoot)\build\llvm\libcxx\include</RxdkLibcxxInc>
    <RxdkLibcxxInc    Condition="'$(RxdkLibcxxInc)'    == ''">$(RxdkModernRoot)\vendor\llvm-project\libcxx\include</RxdkLibcxxInc>
    <RxdkLibcxxabiInc Condition="'$(RxdkLibcxxabiInc)' == '' and '$(_RxdkClean)' == 'true'">$(RxdkModernRoot)\include\libcxxabi</RxdkLibcxxabiInc>
    <RxdkLibcxxabiInc Condition="'$(RxdkLibcxxabiInc)' == '' and Exists('$(RxdkModernRoot)\build\llvm\libcxxabi\include')">$(RxdkModernRoot)\build\llvm\libcxxabi\include</RxdkLibcxxabiInc>
    <RxdkLibcxxabiInc Condition="'$(RxdkLibcxxabiInc)' == ''">$(RxdkModernRoot)\vendor\llvm-project\libcxxabi\include</RxdkLibcxxabiInc>

    <!-- XDK headers (for XDK-headers mode) + import .libs (for genstubs). The clean
         modern tree carries its own copies so it does not reach into the XDK. -->
    <RxdkXdkIncludeDir Condition="'$(RxdkXdkIncludeDir)' == '' and '$(_RxdkClean)' == 'true'">$(RxdkModernRoot)\include\xbox</RxdkXdkIncludeDir>
    <RxdkXdkIncludeDir Condition="'$(RxdkXdkIncludeDir)' == ''">$(XDKInstallDir)include\xbox</RxdkXdkIncludeDir>
    <RxdkXdkLibDir Condition="'$(RxdkXdkLibDir)' == '' and '$(_RxdkClean)' == 'true'">$(RxdkModernRoot)\lib</RxdkXdkLibDir>
    <RxdkXdkLibDir Condition="'$(RxdkXdkLibDir)' == ''">$(RxdkXboxLibDir)</RxdkXdkLibDir>

    <!-- IntelliSense include search order (this is IntelliSense-only: the
         ClangCompile task builds its own -I list from the Rxdk*Inc properties and
         ignores $(IncludePath)).

         XDK-headers mode: the stock XDK headers #include <math.h>/<stdlib.h> at file
         scope (e.g. d3dx9.h), and the IntelliSense parser runs in MSVC mode (no
         __clang__ predefined). libc++'s C wrappers open 'namespace std {' through
         macros that DON'T balance under that parser - so if libc++ is searched first
         for <math.h>, everything the XDK header declares afterwards (D3DXMATRIX, the
         D3DXMatrix* functions, ...) is parsed into std::__1 and reads as "undefined"
         at global scope. Put the plain C headers (picolibc/config) and the XDK
         headers AHEAD of libc++ so the C includes resolve to real C headers; libc++
         stays on the path (last) so <vector>/<string>/... still resolve for std::.

         Pure-modern mode (no XDK headers): keep libc++ first, the normal layering. -->
    <IncludePath Condition="'$(IncludePath)' == '' and '$(RxdkModernXdkHeaders)' == 'true'">$(RxdkConfigInc);$(RxdkPicolibcInc);$(RxdkXdkIncludeDir);$(RxdkLibcxxInc);$(RxdkLibcxxabiInc);</IncludePath>
    <IncludePath Condition="'$(IncludePath)' == ''">$(RxdkLibcxxInc);$(RxdkLibcxxabiInc);$(RxdkConfigInc);$(RxdkPicolibcInc);$(RxdkXdkIncludeDir);</IncludePath>
    <LibraryPath Condition="'$(LibraryPath)' == ''">$(RxdkLibcDir);$(RxdkCoffDir);</LibraryPath>
    <ExecutablePath Condition="'$(ExecutablePath)' == ''">$([System.IO.Path]::GetDirectoryName('$(RxdkClangPath)'));$(PATH);</ExecutablePath>
    <!-- Surfaced read-only on the General property page (general.xml ->
         RxdkToolchainDisplay) so it is obvious at a glance which toolchain a
         project builds with. The legacy 2010-01 toolset sets "Legacy (stock XDK)". -->
    <RxdkToolchain Condition="'$(RxdkToolchain)' == ''">Modern (clang/LLVM)</RxdkToolchain>
  </PropertyGroup>

  <!-- IntelliSense parity with the real compile. The C++ language service never
       runs the ClangCompile task, so it only sees $(IncludePath) plus the ClCompile
       item metadata below - it does NOT see the -include files and -D defines the
       task puts on the actual clang command line. Give it the same ones here (the
       task builds its own command line, so these are inert for the real build):

         * Force-include the libc++ site config + prereqs. Without __config_site,
           libc++'s <__config> never establishes _LIBCPP_ABI_NAMESPACE, so its
           'namespace std {' opens unbalanced and swallows every *global* XDK
           declaration (D3DX*, ...) into std::__1 - which is why calls at file
           scope light up as E0020 "identifier undefined" while the build is clean.
         * Define _GNU_SOURCE/__Picolibc__ so the libc headers match, and (XDK-
           headers mode) the Win32/Xbox gates + _XM_NO_INTRINSICS_ so xnamath/
           xboxmath parse in scalar mode instead of tripping on __vector4 VMX128
           intrinsics the IntelliSense parser doesn't know.

       These files resolve on $(IncludePath) (all three live in the config dir).
       This mirrors AutoClangFlags()/XdkHeaderFlags() in ClangCompile.cs - keep the
       two in sync. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <ForcedIncludeFiles>__config_site;rxdk_libcpp_prereq.h;picolibc.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <PreprocessorDefinitions>__Picolibc__;_GNU_SOURCE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(RxdkModernXdkHeaders)' == 'true'">
    <ClCompile>
      <!-- _M_PPC / _M_PPCBE / _XBOX_VER / __VMX128_SUPPORTED are supplied for
           IntelliSense by the stock xbox_intellisense_platform.h shim (force-included
           via Microsoft.Cl.Xbox 360.props under __INTELLISENSE__); don't redefine
           them here or they clash. These are the remaining gates the shim omits. -->
      <PreprocessorDefinitions>_WIN32=1;_XBOX=1;__export=;_SIZE_T_DEFINED;_XM_NO_INTRINSICS_;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <Import Project="$(VCTargetsPath)\Platforms\Xbox 360\ImportAfter\*.clang.props" Condition="Exists('$(VCTargetsPath)\Platforms\Xbox 360\ImportAfter')" />
</Project>
