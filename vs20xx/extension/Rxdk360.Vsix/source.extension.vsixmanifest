<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0"
                 xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
                 xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="Rxdk360.Vsix.add38e43-cc73-4417-9c4b-e2d43131ab14"
              Version="0.1.1" Language="en-US" Publisher="Team Resurgent" />
    <DisplayName>RXDK-360 - Xbox 360 XDK for modern Visual Studio</DisplayName>
    <Description xml:space="preserve">Build Xbox 360 titles with the stock Xbox 360 XDK toolchain on modern Visual Studio. Adds "Xbox 360 Title" and "Xbox 360 Static Library" project templates for the RXDK-360 platform. The RXDK-360 MSBuild platform and task assembly are installed separately (elevated) by install.ps1.</Description>
    <MoreInfo>https://github.com/Team-Resurgent/RXDK-360</MoreInfo>
    <License>LICENSE.txt</License>
    <Tags>Xbox 360, XDK, PowerPC, RXDK, game development</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework"
                d:Source="Manual" Version="[4.5,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor"
                  Version="[17.0,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.ProjectTemplate"
           d:Source="Project" d:ProjectName="%CurrentProject%" d:TargetPath="ProjectTemplates"
           Path="ProjectTemplates" />
  </Assets>
</PackageManifest>
