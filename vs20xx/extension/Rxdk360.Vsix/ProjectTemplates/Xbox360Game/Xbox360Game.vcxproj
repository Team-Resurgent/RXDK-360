<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- The project configurations, the per-configuration <PropertyGroup Label=
       "Configuration"> blocks, and the per-configuration <ItemDefinitionGroup>
       blocks are emitted by the RXDK-360 template wizard (ToolsetWizard) based on
       the chosen toolchain: the Legacy (stock XDK) toolset gets the full official
       config set (Debug/CodeAnalysis/Profile/Profile_FastCap/Release/Release_LTCG)
       with the matching per-config XDK lib variants; the Modern (clang) toolset
       gets Debug/Release/Release_LTCG (retail libs; Release_LTCG uses clang/lld
       LTO). See ToolsetWizard.cs. -->
  <ItemGroup Label="ProjectConfigurations">
$rxdkprojectconfigurations$
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{$guid1$}</ProjectGuid>
    <RootNamespace>$safeprojectname$</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
$rxdkconfigurationgroups$
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <DeploymentType>CopyToHardDrive</DeploymentType>
  </PropertyGroup>
$rxdkitemdefinitiongroups$
  <ItemGroup>
    <ClCompile Include="main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="shaders\tri_vs.h" />
    <ClInclude Include="shaders\tri_ps.h" />
    <None Include="shaders\tri_vs.hlsl" />
    <None Include="shaders\tri_ps.hlsl" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
