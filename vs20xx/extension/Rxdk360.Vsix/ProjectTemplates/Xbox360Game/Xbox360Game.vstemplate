<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project"
            xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Xbox 360 Game (RXDK-360)</Name>
    <Description>An Xbox 360 game - creates a Direct3D 9 device and draws a spinning, vertex-coloured triangle with precompiled shaders. Builds a bootable .xex with either the Modern (clang/LLVM) or Legacy (stock XDK) toolchain; runs in Xenia or on a devkit.</Description>
    <ProjectType>VC</ProjectType>
    <LanguageTag>C++</LanguageTag>
    <PlatformTag>Xbox 360</PlatformTag>
    <ProjectTypeTag>Games</ProjectTypeTag>
    <SortOrder>1000</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>Xbox360Game</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="$projectname$.vcxproj" File="Xbox360Game.vcxproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="main.cpp">main.cpp</ProjectItem>
      <Folder Name="shaders" TargetFolderName="shaders">
        <ProjectItem ReplaceParameters="false" TargetFileName="tri_vs.h">shaders\tri_vs.h</ProjectItem>
        <ProjectItem ReplaceParameters="false" TargetFileName="tri_ps.h">shaders\tri_ps.h</ProjectItem>
        <ProjectItem ReplaceParameters="false" TargetFileName="tri_vs.hlsl">shaders\tri_vs.hlsl</ProjectItem>
        <ProjectItem ReplaceParameters="false" TargetFileName="tri_ps.hlsl">shaders\tri_ps.hlsl</ProjectItem>
      </Folder>
    </Project>
  </TemplateContent>
  <WizardExtension>
    <Assembly>Rxdk360.TemplateWizard, Version=1.0.0.0, Culture=neutral, PublicKeyToken=8470474b053a39ff</Assembly>
    <FullClassName>Rxdk360.TemplateWizard.ToolsetWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
