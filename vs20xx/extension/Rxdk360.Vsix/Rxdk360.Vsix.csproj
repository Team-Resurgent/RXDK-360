<?xml version="1.0" encoding="utf-8"?>
<!--
  RXDK-360 Visual Studio extension: ships the "Xbox 360 Title" and
  "Xbox 360 Static Library" project templates for the RXDK-360 platform.

  Templates, F5 interceptor, Xbox 360 MSBuild platform, and prebuilt net472
  task DLLs. vsinstall copies the MSBuild payload into each VS VC\Platforms
  folder (a VSIX cannot write there) and runs VSIXInstaller. Hardware F5 is
  Copy to Hard Drive only.

  Build:  msbuild Rxdk360.Vsix.csproj /restore /p:Configuration=Release
  Output: bin\Release\Rxdk360.Vsix.vsix
-->
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{3B1FDDB1-42D5-4D48-906D-B481E3BCE017}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Rxdk360.Vsix</RootNamespace>
    <AssemblyName>Rxdk360.Vsix</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>false</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>bin\Debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>bin\Release\</OutputPath>
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\Rxdk360.Package\DebugAdapterHost.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <Link>DebugAdapterHost.pkgdef</Link>
    </Content>
    <!-- The project-template wizard: build it first (build-order only, no compile
         reference), then ship its DLL in the VSIX root so the WizardExtension binds. -->
    <Content Include="..\Rxdk360.TemplateWizard\bin\$(Configuration)\net472\Rxdk360.TemplateWizard.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <Link>Rxdk360.TemplateWizard.dll</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rxdk360.TemplateWizard\Rxdk360.TemplateWizard.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\Rxdk360.Package\Rxdk360.Package.csproj">
      <Name>Rxdk360.Package</Name>
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup;GetCopyToOutputDirectoryItems;PkgdefProjectOutputGroup</IncludeOutputGroupsInVSIX>
      <IncludeOutputGroupsInVSIXLocalOnly>DebugSymbolsProjectOutputGroup</IncludeOutputGroupsInVSIXLocalOnly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <VSTemplate Include="ProjectTemplates\Xbox360Empty\Xbox360Empty.vstemplate">
      <OutputSubPath>Xbox360Empty</OutputSubPath>
    </VSTemplate>
    <VSTemplate Include="ProjectTemplates\Xbox360Game\Xbox360Game.vstemplate">
      <OutputSubPath>Xbox360Game</OutputSubPath>
    </VSTemplate>
    <VSTemplate Include="ProjectTemplates\Xbox360Title\Xbox360Title.vstemplate">
      <OutputSubPath>Xbox360Title</OutputSubPath>
    </VSTemplate>
    <VSTemplate Include="ProjectTemplates\Xbox360StaticLib\Xbox360StaticLib.vstemplate">
      <OutputSubPath>Xbox360StaticLib</OutputSubPath>
    </VSTemplate>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.9.3168">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets"
          Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

  <!-- Explicitly add the zipped project templates to the VSIX container under
       ProjectTemplates\ (matching the manifest asset Path). The d:Source="Project"
       collection does not pull them in for this templates-only project. -->
  <Target Name="AddRxdk360TemplatesToVsix"
          DependsOnTargets="ZipProjects"
          BeforeTargets="GetVsixSourceItems">
    <ItemGroup>
      <VSIXSourceItem Include="$(OutputPath)ProjectTemplates\**\*.zip">
        <VSIXSubPath>ProjectTemplates\%(RecursiveDir)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <!-- net472 task DLLs + Xbox 360 platform files. Built here (pack time), never on the target. -->
  <Target Name="PackRxdk360Msbuild" BeforeTargets="GetVsixSourceItems">
    <PropertyGroup>
      <_PlatRoot>$(MSBuildThisFileDirectory)..\..\Platforms\Xbox 360\</_PlatRoot>
      <_StockProj>$(MSBuildThisFileDirectory)..\..\tasks\Rxdk.Xbox360.Build\Rxdk.Xbox360.Build.csproj</_StockProj>
      <_ModernProj>$(MSBuildThisFileDirectory)..\..\tasks\Rxdk.Xbox360.Modern.Build\Rxdk.Xbox360.Modern.Build.csproj</_ModernProj>
      <_TaskOut>$(MSBuildThisFileDirectory)obj\$(Configuration)\msbuild-tasks\</_TaskOut>
      <_Vs2022 Condition="Exists('C:\Program Files\Microsoft Visual Studio\2022\Enterprise')">C:\Program Files\Microsoft Visual Studio\2022\Enterprise</_Vs2022>
      <_Vs2022 Condition="'$(_Vs2022)' == '' AND Exists('C:\Program Files\Microsoft Visual Studio\2022\Professional')">C:\Program Files\Microsoft Visual Studio\2022\Professional</_Vs2022>
      <_Vs2022 Condition="'$(_Vs2022)' == '' AND Exists('C:\Program Files\Microsoft Visual Studio\2022\Community')">C:\Program Files\Microsoft Visual Studio\2022\Community</_Vs2022>
      <_Vs18 Condition="Exists('C:\Program Files\Microsoft Visual Studio\18\Enterprise')">C:\Program Files\Microsoft Visual Studio\18\Enterprise</_Vs18>
      <_Vs18 Condition="'$(_Vs18)' == '' AND Exists('C:\Program Files\Microsoft Visual Studio\18\Professional')">C:\Program Files\Microsoft Visual Studio\18\Professional</_Vs18>
      <_Vs18 Condition="'$(_Vs18)' == '' AND Exists('C:\Program Files\Microsoft Visual Studio\18\Community')">C:\Program Files\Microsoft Visual Studio\18\Community</_Vs18>
    </PropertyGroup>
    <Error Condition="'$(_Vs2022)' == ''" Text="VS 2022 not found; needed to bind Rxdk.Xbox360.Build.dll against v170 CPPTasks." />
    <MakeDir Directories="$(_TaskOut)v170;$(_TaskOut)v180;$(_TaskOut)modern" />
    <Exec Command="dotnet build &quot;$(_ModernProj)&quot; -c $(Configuration) -o &quot;$(_TaskOut)modern&quot; -v q -nologo" />
    <Exec Command="dotnet build &quot;$(_StockProj)&quot; -c $(Configuration) -o &quot;$(_TaskOut)v170&quot; -p:VcTaskVersion=v170 -p:VsInstallDir=&quot;$(_Vs2022)\\&quot; -v q -nologo" />
    <Exec Condition="'$(_Vs18)' != ''" Command="dotnet build &quot;$(_StockProj)&quot; -c $(Configuration) -o &quot;$(_TaskOut)v180&quot; -p:VcTaskVersion=v180 -p:VsInstallDir=&quot;$(_Vs18)\\&quot; -v q -nologo" />
    <ItemGroup>
      <_Plat Include="$(_PlatRoot)**\*" Exclude="$(_PlatRoot)**\*.dll" />
      <VSIXSourceItem Include="@(_Plat)">
        <VSIXSubPath>MSBuild\Xbox 360\%(RecursiveDir)</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(_TaskOut)v170\Rxdk.Xbox360.Build.dll">
        <VSIXSubPath>MSBuild\tasks\v170</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(_TaskOut)v180\Rxdk.Xbox360.Build.dll" Condition="Exists('$(_TaskOut)v180\Rxdk.Xbox360.Build.dll')">
        <VSIXSubPath>MSBuild\tasks\v180</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(_TaskOut)modern\Rxdk.Xbox360.Modern.Build.dll">
        <VSIXSubPath>MSBuild\tasks</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <!-- win-x86 DAP host (P/Invoke xbdm.dll). Copy-to-Drive F5 launches this via Debug Adapter Host. -->
  <Target Name="PublishRxdk360Adapter" BeforeTargets="GetVsixSourceItems">
    <PropertyGroup>
      <_AdapterProj>$(MSBuildThisFileDirectory)..\..\debugger\Rxdk.Xbox360.DebugAdapter\Rxdk.Xbox360.DebugAdapter.csproj</_AdapterProj>
      <_AdapterOut>$(IntermediateOutputPath)adapter\</_AdapterOut>
    </PropertyGroup>
    <Message Importance="high" Text="RXDK-360: publishing Rxdk.Xbox360.DebugAdapter (win-x86) into the VSIX under tools\ ..." />
    <Exec Command="dotnet publish &quot;$(_AdapterProj)&quot; -c $(Configuration) -r win-x86 --self-contained true -o &quot;$(_AdapterOut.TrimEnd('\'))&quot; -v q -nologo" />
    <ItemGroup>
      <_AdapterFile Include="$(_AdapterOut)**\*" Exclude="$(_AdapterOut)**\*.pdb" />
      <VSIXSourceItem Include="@(_AdapterFile)">
        <VSIXSubPath>tools\%(RecursiveDir)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>
</Project>
