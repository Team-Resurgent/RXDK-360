<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RXDK-360 DWARF reader - the symbol backbone of the modern devkit debugger.
    Reads the .debug_* sections of a linked PowerPC big-endian ELF (produced by a
    Debug modern build) into functions, a line table and locals, with the address
    <-> source queries a stepping debugger needs. Standalone (not an in-proc VS
    task), so it targets modern .NET; the coming debug adapter references it and
    drives the devkit over the XDK's xbdm.dll.

    Build with dotnet build; run RxdkDwarf.exe over a title.elf with a mode flag
    (funcs, lines, locals, addr, line).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RxdkDwarf</AssemblyName>
    <RootNamespace>Rxdk.Xbox360.Dwarf</RootNamespace>
    <Deterministic>true</Deterministic>
    <Company>Team Resurgent</Company>
    <Product>RXDK-360</Product>
    <Copyright>Copyright (C) Team Resurgent. GPL-3.0-or-later.</Copyright>
  </PropertyGroup>

</Project>
