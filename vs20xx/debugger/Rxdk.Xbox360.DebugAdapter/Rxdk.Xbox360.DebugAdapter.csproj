<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RXDK-360 devkit debug adapter (Debug Adapter Protocol).

    Glues the symbol reader (Rxdk.Xbox360.Dwarf) and the devkit transport
    (Rxdk.Xbox360.Xbdm) into an editor-facing DAP server, so F5-to-devkit steps
    source: reboot the title stopped, set breakpoints at source lines, and on a
    break map the PC to source and read locals from the stopped frame. Windows-only
    (drives xbdm.dll through the XBDM client).

    Build with dotnet build; run RxdkDebugAdapter with the selftest flag and an elf
    for the offline symbol-glue check.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RxdkDebugAdapter</AssemblyName>
    <RootNamespace>Rxdk.Xbox360.DebugAdapter</RootNamespace>
    <Deterministic>true</Deterministic>
    <Company>Team Resurgent</Company>
    <Product>RXDK-360</Product>
    <Copyright>Copyright (C) Team Resurgent. GPL-3.0-or-later.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rxdk.Xbox360.Dwarf\Rxdk.Xbox360.Dwarf.csproj" />
    <ProjectReference Include="..\Rxdk.Xbox360.Xbdm\Rxdk.Xbox360.Xbdm.csproj" />
  </ItemGroup>

</Project>
