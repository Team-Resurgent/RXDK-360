<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RXDK-360 XBDM client - the devkit transport for the modern debugger.

    A managed facade over the XDK's PC-side xbdm.dll (P/Invoke of the DM* APIs), so
    we drive a real Xbox 360 devkit (deploy, reboot into a title stopped for debug,
    breakpoints, stop/go, memory, thread registers, debug-event notifications)
    Windows-only (x86): P/Invoke of %XEDK%\bin\win32\xbdm.dll using the
    signatures in include\win32\xbdm.h. Locates that DLL from the XDK / RXDK-360
    install.

    Build with dotnet build; run Rxdk.Xbox360.Xbdm info for the offline self-check.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>Rxdk.Xbox360.Xbdm</AssemblyName>
    <RootNamespace>Rxdk.Xbox360.Xbdm</RootNamespace>
    <Deterministic>true</Deterministic>
    <Company>Team Resurgent</Company>
    <Product>RXDK-360</Product>
    <Copyright>Copyright (C) Team Resurgent. GPL-3.0-or-later.</Copyright>
  </PropertyGroup>

</Project>
