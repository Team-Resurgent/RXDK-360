#ifndef _LIBCPP___ASSERTION_HANDLER
#define _LIBCPP___ASSERTION_HANDLER

#include <__config>

// Hardening is disabled for the RXDK-360 runtime (__config_site sets
// _LIBCPP_HARDENING_MODE_NONE), so assertions compile out. Provide the standard
// verbose-abort handler for completeness.
#define _LIBCPP_ASSERTION_HANDLER(message) _LIBCPP_VERBOSE_ABORT("%s", message)

#endif // _LIBCPP___ASSERTION_HANDLER
