*.o
*.obj
*.dis
*.s
!spike/abi/*.c
zig-cache/
zig-out/
.zig-cache/
__pycache__/
build/
t1.*
t_*.s
probe_*.s
probe_*.ll
*.obj
build-log*.txt

# Installer executables (e.g. the XDK setup payload dropped in xdksetup/) --
# kept locally, never committed. A setup script will extract what the toolchain
# needs from it when we get there. See xdksetup/README.md.
*.exe
.xdkdoc/

# The unpacked XDK payload (proprietary Microsoft headers/libs/media the user
# extracts locally) -- never committed. Only xdksetup/README.md is tracked.
/xdksetup/*
!/xdksetup/README.md

# real hand-written asm sources (the *.s rule above is for generated files)
!runtime/xbox/*.S
